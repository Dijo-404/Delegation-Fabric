# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-south1

# Delegation Fabric environment
DF_ENV=hackathon
DF_CONTROL_PLANE_URL=https://control-plane-XXXXXXXX-el.a.run.app
DF_EXECUTION_GATEWAY_URL=https://execution-gateway-XXXXXXXX-el.a.run.app
DF_CONSOLE_URL=https://console-XXXXXXXX-el.a.run.app

# Service wiring (defaults are local/in-memory; set for cloud deploys)
# DF_STORE=memory|firestore
# DF_FIRESTORE_PROJECT=your-project-id
# DF_ERP_BACKEND=file|postgres
# DF_ERP_DATASET_PATH=seed/erp/dataset.json
# DATABASE_URL=postgresql+asyncpg://user:pass@host/delegation_fabric   (from Secret Manager)
# DF_PUBSUB_PROJECT=your-project-id  → enables real Pub/Sub publishing

# KMS
# Format: projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/VERSION
DF_KMS_KEY_VERSION=projects/YOUR_PROJECT/locations/asia-south1/keyRings/delegation-fabric/cryptoKeys/execution-grant-signing/cryptoKeyVersions/1
DF_GRANT_ISSUER=delegation-fabric-control-plane
DF_GRANT_AUDIENCE=delegation-fabric-execution-gateway
DF_GRANT_TTL_SECONDS=300
DF_CLOCK_SKEW_SECONDS=30

# Model
DF_MODEL_ID=gemini-3.5-flash
DF_SEMANTIC_GOVERNANCE_MODE=dry_run
# DF_MODEL_ARMOR_TEMPLATE=projects/YOUR_PROJECT/locations/asia-south1/modelArmorTemplates/YOUR_TEMPLATE

# Cloud SQL
# DF_CLOUD_SQL_INSTANCE=YOUR_PROJECT:asia-south1:delegation-fabric
DF_DB_NAME=delegation_fabric
# DB credentials come from Secret Manager at runtime — do NOT put them here

# Policy
DF_POLICY_VERSION=finance-policy-2026-08-20.1
